# Copy to .env and adjust. `.env` is gitignored.

# ── Source checkouts (built by docker compose build) ─────────────────────
HEIMDALL_SRC=../../../lantr/heimdall
BINOCULAR_SRC=../../../lantr/binocular

# ── Version pins (scripts/00-lib.sh warns when a checkout's HEAD differs) ─
HEIMDALL_REF=afd8b0b
BINOCULAR_REF=0e7e261

# ── Images ───────────────────────────────────────────────────────────────
BITCOIND_IMAGE=bitcoin/bitcoin:28.1
# Tag from yaci-devkit's own docker distribution. The devnet's PROTOCOL VERSION
# is a compatibility pin, not a preference: Scalus 1.0.0 (binocular, 2026-07-30)
# compiles for vanRossem = PV11, and a PV10 node rejects those scripts at submit
# with `MalformedReferenceScripts` — an error that names a script hash and
# nothing about protocol versions. 0.11.0-beta1 is cardano-node 10.5.0 = PV10;
# 0.12.0-beta5 is cardano-node 11.0.1 = PV11.
# Check with: curl -s localhost:8080/api/v1/epochs/latest/parameters | jq .protocol_major_ver
YACI_CLI_IMAGE=bloxbean/yaci-cli:0.12.0-beta5

# ── Bitcoin RPC ──────────────────────────────────────────────────────────
# In-compose regtest by default. For a testnet4 smoke run against an
# external node: point BITCOIN_RPC_URL at it and start compose without the
# bitcoind service (scenario 3 stays regtest-only — it mines CSV blocks).
BITCOIN_RPC_URL=http://bitcoind:18443
BITCOIN_RPC_USER=bifrost
BITCOIN_RPC_PASS=bifrost

# ── Wallets (devnet-only test mnemonics; funded via the yaci faucet) ─────
HEIMDALL_MNEMONIC="test walk nut penalty hip pave soap entry language right filter choice"
WALLET_MNEMONIC="all all all all all all all all all all all all"
